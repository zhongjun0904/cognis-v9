# 在后端部署平台的环境变量设置里填写真实值；这个文件只是示范，严禁填入密钥后提交 GitHub。
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
# 选择你自己的 OpenAI API 项目有权限使用的模型，以下为兼容性较好的示例。
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# GitHub Pages 使用网页来源 origin，不能带仓库子路径 /repo。
CORS_ALLOWED_ORIGINS=https://YOUR_USERNAME.github.io;http://localhost:3000
# 公开演示时强烈建议设置并只分享给体验者；正式多用户上线仍需要账号、额度与独立限流。
DEMO_ACCESS_CODE=YOUR_PRIVATE_TRIAL_CODE
DAILY_REQUEST_LIMIT=120
MINUTE_REQUEST_LIMIT=30
MAX_CONCURRENT_REQUESTS=4
# Render 等反向代理平台设为 1，才能按真实客户端 IP 限流；本机直连保持 0。
TRUST_PROXY=1
HOST=0.0.0.0
PORT=3000
# 仅本机 file:// 开发测试可打开；生产不要启用。
ALLOW_LOCAL_FILE=0
# 生产环境默认必须设置 DEMO_ACCESS_CODE。只有在已有外部认证与配额网关时才考虑显式设为 1。
ALLOW_PUBLIC_API=0
